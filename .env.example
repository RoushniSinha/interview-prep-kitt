# ==============================================================================
# Interview Prep Kit — Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=5000
ALLOW_PRIVATE_NETWORK=false

# Database Persistence (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.gulp5qi.mongodb.net/interview_prep_db?retryWrites=true&w=majority
DB_NAME=interview_prep_db

# Google Cloud Vertex AI Search & Conversation (Discovery Engine)
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=global
VERTEX_ENGINE_ID=your-vertex-engine-id
VERTEX_DATA_STORE_ID=company-research-datastore_1790224511792
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-key.json
VERTEX_TIMEOUT_MS=15000
VERTEX_MAX_RETRIES=3

# Gemini Multimodal LLM Orchestration
GEMINI_API_KEY=your-gemini-api-key

# Authentication & Session Security
JWT_SECRET=your-jwt-secret-at-least-8-chars

# Environment & Application Hosting
NODE_ENV=development
APP_URL=http://localhost:5000
